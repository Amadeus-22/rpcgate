# Copy to .env for `make run`. All process settings are environment variables;
# the upstream list lives in the YAML file named by RPCGATE_CONFIG.
RPCGATE_CONFIG=config.example.yaml
RPCGATE_LISTEN_ADDR=:8545
RPCGATE_LOG_LEVEL=info

# Referenced from config.example.yaml as ${RPCGATE_DEMO_KEY}.
RPCGATE_DEMO_KEY=change-me
